{
  "name": "raser-infra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "build:client": "npm --prefix ../client run build",
    "generate:client": "npm --prefix ../server run db:generate",
    "synth": "npm run build:client && npm run generate:client && cdk synth",
    "diff": "npm run build:client && npm run generate:client && cdk diff",
    "deploy": "npm run build:client && npm run generate:client && cdk deploy"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.0.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0",
    "dotenv": "^18.0.9"
  }
}
