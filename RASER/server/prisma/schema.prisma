
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

//NOTE: if u have the prisma extension it will flag an error here for not having a URL, you can ignore it 
datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model Rubric {
    id Int @id @default(autoincrement())
    assignedDesignerId Int?
    title String
    publishDate DateTime?
    deprecationDate DateTime? 
    replacementRubricId Int?
    maxScoreComputed Int?
    lowQualThreshold Int?
    highQualThreshold Int?
    sampleURL String?
    
    sections Section[]
}

model Section {
    id Int @id @default(autoincrement())
    heading String
    assignedRubricId Int 
    questions Question[]
    
    rubric Rubric @relation(fields: [assignedRubricId], references: [id])
}

model Question {
    id Int @id @default(autoincrement())
    question String
    explanation String
    rating1Description String @default("")
    rating2Description String @default("")
    rating3Description String @default("")
    rating4Description String @default("")
    rating5Description String @default("")
    assignedSectionId Int

    section Section @relation(fields: [assignedSectionId], references: [id])
}

model RubricDesigner {
    designerId Int @id @default(autoincrement())
    name String
    email String 
    password String
}
