generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

//NOTE: if u have the prisma extension it will flag an error here for not having a URL, you can ignore it 
datasource db {
  provider = "postgresql"
}

enum UserRole {
  DESIGNER
  REVIEWER
  EDITOR
}

enum PaperStatus {
  IN_REVIEW
  WITHDRAWN
}

model User {
  id      Int      @id @default(autoincrement())
  name    String
  email   String   @unique
  auth0Id String?  @unique
  role    UserRole @default(REVIEWER)

  reviewAssignments ReviewAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rubric {
  id                  Int       @id @default(autoincrement())
  assignedDesignerId  Int?
  title               String
  publishDate         DateTime?
  deprecationDate     DateTime?
  replacementRubricId Int?
  maxScoreComputed    Int?
  lowQualThreshold    Int?
  highQualThreshold   Int?
  sampleURL           String?
  assignedJournalIds  Int[]     @default([])

  sections Section[]
}

model Journal {
  id               Int    @id @default(autoincrement())
  assignedEditorId Int?
  name             String

  issues           Issue[]
}

model Issue {
  id               Int    @id @default(autoincrement())
  assignedEditorId Int?
  volumeNumber     Int
  issueNumber      Int
  journalId        Int

  journal Journal @relation(fields: [journalId], references: [id])
  papers  Paper[]
}

model Paper {
  id        Int         @id @default(autoincrement())
  title     String
  authors   String?
  status    PaperStatus @default(IN_REVIEW)
  issueId   Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  issue             Issue              @relation(fields: [issueId], references: [id])
  reviewAssignments ReviewAssignment[]
}

model ReviewAssignment {
  id         Int      @id @default(autoincrement())
  paperId    Int
  reviewerId Int
  createdAt  DateTime @default(now())

  paper    Paper @relation(fields: [paperId], references: [id])
  reviewer User  @relation(fields: [reviewerId], references: [id])

  @@unique([paperId, reviewerId])
}

model Section {
  id               Int        @id @default(autoincrement())
  heading          String
  assignedRubricId Int
  questions        Question[]

  rubric Rubric @relation(fields: [assignedRubricId], references: [id])
}

model Question {
  id                 Int    @id @default(autoincrement())
  question           String
  criteria           String
  rating1Description String @default("")
  rating2Description String @default("")
  rating3Description String @default("")
  rating4Description String @default("")
  rating5Description String @default("")
  assignedSectionId  Int

  section Section @relation(fields: [assignedSectionId], references: [id])
}

model RubricDesigner {
  designerId Int    @id @default(autoincrement())
  name       String
  email      String
  password   String
}

model JournalEditor {
  editorId Int    @id @default(autoincrement())
  name     String
  email    String
  password String
}
